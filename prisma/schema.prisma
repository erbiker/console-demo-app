generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A user to be granted permissions via this application
// Note: distinct from a authenticated user of this application
model User {
  id         String    @id @default(cuid())
  email      String    @unique
  firstName  String
  lastName   String
  avatar     String?
  title      String?
  department String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  UserGroups                   UserGroup[]
  OwnedApps                    App[]
  AccessPolicyApprovalReviewer AccessPolicyApprovalReviewer[]
  VisibleAccessPolicies        AccessPolicy[]

  @@index([email])
}

// An access group granting various permissions to users
model UserGroup {
  id          String  @id @default(cuid())
  name        String
  description String?
  note        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  Users                 User[]
  VisibleAccessPolicies AccessPolicy[]

  @@index([name])
}

// An application whose access is granted to users
model App {
  id   String @id @default(cuid())
  name String

  url  String?
  logo String?

  Owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  ownerId String

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  AccessPolicies AccessPolicy[]
}

// A policy that specifies how to grant access to an app
model AccessPolicy {
  id String @id @default(cuid())

  name        String
  description String

  App   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  Approvals AccessPolicyApproval[]

  publishedAt DateTime?

  ProvisioningActions AccessPolicyProvisioningAction[]

  // If true, ignore user and group visibility and grant visibility to all users
  universalVisibility Boolean     @default(false)
  UserVisibility      User[]
  UserGroupVisibility UserGroup[]

  indefiniteAccess Boolean @default(false)
  accessLengthDays Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model AccessPolicyApproval {
  id String @id @default(cuid())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  AccessPolicy      AccessPolicy                   @relation(fields: [accessPolicyId], references: [id], onDelete: Cascade)
  accessPolicyId    String
  ApprovalReviewers AccessPolicyApprovalReviewer[]

  priority Int
}

model AccessPolicyApprovalReviewer {
  id String @id @default(cuid())

  User                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String
  AccessPolicyApproval   AccessPolicyApproval @relation(fields: [accessPolicyApprovalId], references: [id], onDelete: Cascade)
  accessPolicyApprovalId String

  requiredReviewer Boolean @default(true)
}

model AccessPolicyProvisioningAction {
  id String @id @default(cuid())

  createdAt                    DateTime                           @default(now())
  updatedAt                    DateTime                           @updatedAt
  deletedAt                    DateTime?
  AccessPolicy                 AccessPolicy                       @relation(fields: [accessPolicyId], references: [id], onDelete: Cascade)
  accessPolicyId               String
  ProvisioningServiceAPICall   ProvisioningServiceAPICall?        @relation(fields: [provisioningServiceAPICallId], references: [id], onDelete: Cascade)
  provisioningServiceAPICallId String?
  actionType                   AccessPolicyProvisioningActionType
}

enum AccessPolicyProvisioningActionType {
  GRANT_ACCESS
  REVOKE_ACCESS
}

model ProvisioningService {
  id String @id @default(cuid())

  name String

  ProvisioningServiceAPICalls ProvisioningServiceAPICall[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model ProvisioningServiceAPICall {
  id          String  @id @default(cuid())
  name        String
  description String?

  ProvisioningActions AccessPolicyProvisioningAction[]

  ProvisioningService   ProvisioningService @relation(fields: [provisioningServiceId], references: [id], onDelete: Cascade)
  provisioningServiceId String

  apiEndpoint    String
  requestMethod  String
  requestHeaders String
  requestBody    String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}
