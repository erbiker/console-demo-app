generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A user to be granted permissions via this application
// Note: distinct from a authenticated user of this application
model User {
  id         String    @id @default(cuid())
  email      String    @unique
  firstName  String
  lastName   String
  avatar     String?
  title      String?
  department String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  UserGroups                   UserGroup[]
  OwnedApps                    App[]
  AccessPolicyApprovalReviewer AccessPolicyApprovalReviewer[]
  VisibleAccessPolicies        AccessPolicy[]

  @@index([email])
}

// An access group granting various permissions to users
model UserGroup {
  id          String  @id @default(cuid())
  name        String
  description String?
  note        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  Users                 User[]
  VisibleAccessPolicies AccessPolicy[]
}

// An application whose access is granted to users
model App {
  id   String @id @default(cuid())
  name String

  url  String?
  logo String?

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  AccessPolicy AccessPolicy[]
}

// A policy that specifies how to grant access to an app
model AccessPolicy {
  id String @id @default(cuid())

  name        String
  description String

  app   App    @relation(fields: [appId], references: [id])
  appId String

  approvals AccessPolicyApproval[]

  publishedAt DateTime?

  AccessPolicyProvisioningActions AccessPolicyProvisioningAction[]

  // If true, ignore user and group visibility and grant visibility to all users
  universalVisibility Boolean     @default(false)
  UserVisibility      User[]
  UserGroupVisibility UserGroup[]

  indefiniteAccess Boolean @default(false)
  accessLengthDays Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model AccessPolicyApproval {
  id String @id @default(cuid())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  AccessPolicy                 AccessPolicy                   @relation(fields: [accessPolicyId], references: [id])
  accessPolicyId               String
  AccessPolicyApprovalReviewer AccessPolicyApprovalReviewer[]

  priority Int
}

model AccessPolicyApprovalReviewer {
  id String @id @default(cuid())

  user                   User                 @relation(fields: [userId], references: [id])
  userId                 String
  AccessPolicyApproval   AccessPolicyApproval @relation(fields: [accessPolicyApprovalId], references: [id])
  accessPolicyApprovalId String

  requiredReviewer Boolean @default(true)
}

model AccessPolicyProvisioningAction {
  id String @id @default(cuid())

  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  deletedAt                    DateTime?
  AccessPolicy                 AccessPolicy               @relation(fields: [accessPolicyId], references: [id])
  accessPolicyId               String
  ProvisioningServiceAPICall   ProvisioningServiceAPICall @relation(fields: [provisioningServiceAPICallId], references: [id])
  provisioningServiceAPICallId String
}

model ProvisioningService {
  id String @id @default(cuid())

  name String

  ProvisioningServiceAPICalls ProvisioningServiceAPICall[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model ProvisioningServiceAPICall {
  id String @id @default(cuid())

  AccessPolicyProvisioningActions AccessPolicyProvisioningAction[]

  ProvisioningService   ProvisioningService @relation(fields: [provisioningServiceId], references: [id])
  provisioningServiceId String

  apiEndpoint    String
  requestMethod  String
  requestHeaders String
  requestBody    String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}
