generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A user to be granted permissions via this application
// Note: distinct from a authenticated user of this application
model User {
  id         String    @id @default(cuid())
  email      String    @unique
  firstName  String
  lastName   String
  avatar     String?
  title      String?
  department String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  UserGroups                   UserGroup[]
  OwnedApps                    App[]
  AccessPolicyApprovalReviewer AccessPolicyApprovalReviewer[]

  @@index([email])
}

// An access group granting various permissions to users
model UserGroup {
  id          String  @id @default(cuid())
  name        String?
  description String?
  note        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  Users User[]
}

// An application whose access is granted to users
model App {
  id   String @id @default(cuid())
  name String

  url  String?
  logo String?

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  AccessPolicy AccessPolicy[]
}

// A policy that specifies how to grant access to an app
model AccessPolicy {
  id String @id @default(cuid())

  name        String
  description String

  app   App    @relation(fields: [appId], references: [id])
  appId String

  approvals AccessPolicyApproval[]

  publishedAt DateTime?

  provisioningActions ProvisioningAction[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model AccessPolicyApproval {
  id String @id @default(cuid())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  AccessPolicy                 AccessPolicy                   @relation(fields: [accessPolicyId], references: [id])
  accessPolicyId               String
  AccessPolicyApprovalReviewer AccessPolicyApprovalReviewer[]

  priority Int
}

model AccessPolicyApprovalReviewer {
  id String @id @default(cuid())

  user                   User                 @relation(fields: [userId], references: [id])
  userId                 String
  AccessPolicyApproval   AccessPolicyApproval @relation(fields: [accessPolicyApprovalId], references: [id])
  accessPolicyApprovalId String
}

model ProvisioningAction {
  id String @id @default(cuid())

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  AccessPolicy   AccessPolicy? @relation(fields: [accessPolicyId], references: [id])
  accessPolicyId String?
}
